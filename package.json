{
  "name": "remindmelater",
  "version": "0.34.0",
  "private": true,
  "description": "Calendario, recordatorios, tareas y notas de escritorio (Electron + SQLite), sin servidor ni red",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "electron": "electron .",
    "dist": "electron-builder --win",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.koku.remindmelater",
    "productName": "RemindMeLater",
    "files": [
      "core/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
