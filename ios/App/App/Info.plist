<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>RemindMeLater</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.koku.remindmelater</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>remindmelater</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AQUI NO HAY NI NSAppTransportSecurity NI un texto de permiso de red
	     local, Y ES A PROPOSITO. Los dos eran restos del programa
	     cliente-servidor:
	       * La excepcion de ATS permitia conectarse a cualquier sitio,
	         incluso por HTTP sin cifrar, para hablar con el servidor del
	         ordenador. Ya no hay servidor; lo unico que quedaba era
	         superficie de ataque (si alguien lograra ejecutar codigo en la
	         webview podria mandarse la base entera a cualquier parte) y una
	         pregunta segura en la revision de la App Store.
	       * El texto de red local describia una sincronizacion que la app ya
	         no hace, o sea que le habria mentido al usuario en el dialogo de
	         permiso. Sin la clave, iOS ni siquiera pide ese permiso.
	     La app no hace NINGUNA peticion de red: no cargar nada de fuera es
	     parte del diseño. Ver SEGURIDAD-Y-PRIVACIDAD.md. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Modo de fondo "audio": mantiene la app despierta MIENTRAS suena el
	     silencio a volumen 0 del descanso (RestAudioWatcher), que es lo que
	     permite bajar la musica justo al acabar aunque el movil este
	     bloqueado. Fuera del descanso no hay nada sonando y la app se
	     suspende con normalidad. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- SOLO VERTICAL en el iPhone (peticion de Koku). Toda la interfaz
	     esta pensada mobile-first en vertical: en apaisado la barra de
	     abajo, el calendario y las pantallas completas se quedan sin
	     alto util. Se deja UIInterfaceOrientationPortrait a secas, sin
	     PortraitUpsideDown, porque el iPhone no gira solo del reves.
	     Aqui SI se puede recortar la lista (el iPhone no tiene el
	     requisito de multitarea del iPad); ojo con la de abajo. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- OJO, NO recortar esta lista: App Store Connect RECHAZA la subida
	     (error 90474) si el bundle dice que vale para iPad y no declara
	     las cuatro orientaciones, porque las exige para el multitarea de
	     iPad. Ya paso una vez: la build #39 compilo y exporto bien, y
	     reboto justo al subir.
	     Que la app no rote de verdad se resuelve en codigo, no aqui: ver
	     supportedInterfaceOrientations en BridgeViewController.swift,
	     que manda por encima de esta lista.
	     (La otra salida seria dejar la app solo para iPhone, con
	     TARGETED_DEVICE_FAMILY = "1", pero eso es una decision de
	     producto distinta, no un arreglo de este error.)
	     Ojo tambien con los guiones dobles: dentro de un comentario XML
	     son ilegales y rompen el plist entero. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
