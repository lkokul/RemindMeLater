# Capacitor -- proyectos nativos (android/, ios/) se comitean tal cual
# (convencion estandar de Capacitor, no son puramente derivados), pero
# sus artefactos de build si son derivados y se excluyen:
android/app/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/DerivedData/
