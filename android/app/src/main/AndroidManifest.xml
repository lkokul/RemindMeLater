<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false": los datos de la app NO se suben a la copia
         automatica de Google (Auto Backup for Apps). Estaba en "true", que
         es el valor por defecto de Android, y eso subia a Google Drive el
         calendario, las notas, las finanzas y el gimnasio: justo lo
         contrario de lo que promete la app, y ademas obligaba a declararlo
         en el formulario de Data Safety de Play. La copia de seguridad de
         esta app es la funcion de exportar, que es explicita y la controla
         el usuario. Ver SEGURIDAD-Y-PRIVACIDAD.md.
         Efecto util de paso: al restaurar un movil ya no puede volver por
         detras una base antigua sin que la app se entere.
         Se quito tambien usesCleartextTraffic, resto del programa
         cliente-servidor: la app no hace ninguna peticion de red. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- SOLO VERTICAL (peticion de Koku, igual que en iOS via
             Info.plist). "portrait" bloquea la rotacion aunque el
             telefono tenga el giro automatico encendido. Se deja
             "orientation" dentro de configChanges: no sobra, es lo que
             evita que Android reinicie la Activity entera (y con ella
             la webview) si algo llegara a provocar un cambio de
             configuracion de este tipo. -->
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos. INTERNET se queda porque la webview de Capacitor lo pide
         para su propio puente interno (esquema http://localhost), no porque
         la app hable con ningun servidor: no hay ni una peticion de red a
         internet en todo el codigo. -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
